# ---------------------------------------------------------------------------
# OnionScout configuration. Copy this file to `.env` and fill in values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Tor ---
# SOCKS5 proxy exposed by the Tor daemon (default for `tor` on Debian/Ubuntu).
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050

# Tor ControlPort, used to request new circuits (identity rotation).
# Enable it in /etc/tor/torrc:
#     ControlPort 9051
#     HashedControlPassword <output of: tor --hash-password yourpass>
TOR_CONTROL_HOST=127.0.0.1
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=

# --- Networking ---
# Per-request timeout (seconds) and how many times to retry over fresh circuits.
REQUEST_TIMEOUT=30
MAX_RETRIES=2
# Concurrent worker threads for search / fetch / link-checking.
MAX_WORKERS=8

# --- Cache ---
# SQLite cache of fetched pages. Set CACHE_ENABLED=0 to disable.
CACHE_ENABLED=1
CACHE_PATH=.onionscout_cache.sqlite
CACHE_TTL=86400

# --- LLM analysis (optional) ---
# Provider: openai | anthropic | gemini | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# For local models via Ollama:
OLLAMA_HOST=http://127.0.0.1:11434
